+                let requests = requests.clone();
+                let barrier = barrier.clone();
+                async move {
+                    requests.lock().unwrap().push((uri.path().to_owned(), request.clone()));
+                    if request["with_payload"] == true {
+                        return Json(json!({"result":{"points":[{"payload":{"_source":{"brand":"A","price":3}}}],"next_page_offset":null}})).into_response();
+                    }
+                    barrier.wait().await;
+                    if uri.path().ends_with("/scroll") {
+                        return Json(json!({"result":{"points":if covered { json!([]) } else { json!([{"id":1}]) }}})).into_response();
+                    }
+                    if !covered {
+                        return (StatusCode::INTERNAL_SERVER_ERROR, Json(json!({"error":"speculative reads must be discarded"}))).into_response();
+                    }
