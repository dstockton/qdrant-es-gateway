+// Called inside each bounded read future, before its result is retained. Keep
+// errors as values until the shared coverage proof makes the read authoritative.
+fn indexed_result(response: &Value, terms_size: Option<usize>) -> Result<Value, GatewayError> {
+    if let Some(size) = terms_size {
+        Ok(Reduction::Terms {
+            field: String::new(),
+            size,
+            counts: facet_counts(response)?,
+        }
+        .finish())
+    } else {
+        let count = response
+            .pointer("/result/count")
+            .and_then(Value::as_u64)
+            .ok_or_else(|| bad("invalid Qdrant count response"))?;
+        Ok(json!({"doc_count":count}))
+    }
+}
